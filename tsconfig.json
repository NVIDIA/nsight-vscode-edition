{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "module": "es2022",
        "moduleResolution": "bundler",
        "emitDeclarationOnly": true,
        "allowImportingTsExtensions": true,
    },
    "include": ["**/*.ts", "**/*.mts", "**/*.js", "**/*.mjs", "**/*.json"],
    "exclude": [
        ".vscode-test",
        "cdt-gdb-adapter",
        "node_modules",
        "out",
        "src",
        "test",
        "**/build"
    ],
    "references": [
        {"path": "src"},
        {"path": "src/test"},
        {"path": "test"},
    ]
}
